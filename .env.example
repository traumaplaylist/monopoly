# --- Server (apps/server) ---
# Port and interface. In production put the server behind HTTPS/WSS (reverse proxy) and keep HOST=127.0.0.1.
PORT=3001
HOST=127.0.0.1
# SQLite file with rooms, matches and guest sessions.
DB_PATH=./data/party-board.sqlite
# Comma-separated browser origins allowed to connect (production). Include native WebView origins.
ALLOWED_ORIGINS=https://game.example.com,capacitor://localhost,https://localhost
# Serve the built web client from the same process (optional).
STATIC_DIR=./apps/client/dist
# Dev mode: debug rooms with bots. NEVER enable in production.
PB_DEV=0

# --- Client build (apps/client), read at build time by Vite ---
# Game server URL for builds that are not served by the game server itself (e.g. Capacitor apps).
VITE_SERVER_URL=https://game.example.com
