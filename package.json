{
  "name": "party-board",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "engines": { "node": ">=22.13" },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "npm run dev -w @pb/server",
    "dev:client": "npm run dev -w @pb/client",
    "build": "npm run typecheck && npm run build -w @pb/client && npm run build -w @pb/server",
    "start": "npm run start -w @pb/server",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "e2e": "playwright test",
    "format": "prettier --write packages apps/client/src apps/server/src tests"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^26.6.5",
    "prettier": "^3.6.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
